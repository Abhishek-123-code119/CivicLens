APP_NAME=CivicLens
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/civiclens
SECRET_KEY=replace_with_a_secure_generated_secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
MODEL_ENABLED=false
MODEL_PATH=models/civic_damage.pt
MODEL_CONFIDENCE_THRESHOLD=0.35
MODEL_IMAGE_SIZE=640
MODEL_DEVICE=cpu
MAX_UPLOAD_SIZE_MB=10
IMAGE_STORAGE_BACKEND=local
IMAGE_STORAGE_PATH=storage/uploads
CLUSTER_RADIUS_METERS=100
CLUSTER_LOOKBACK_DAYS=30
CLUSTER_MATCH_THRESHOLD=0.80
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
MAP_ATTRIBUTION="&copy; OpenStreetMap contributors"
